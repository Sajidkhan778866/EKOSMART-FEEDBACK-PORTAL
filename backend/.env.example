# Backend Environment Variables for cPanel / Production
PORT=5000
NODE_ENV=production

# MongoDB Atlas or Remote Database Connection URI
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/ekosmart?retryWrites=true&w=majority

# Secret key for Admin, Employee & Customer JWT authentication
JWT_SECRET=your_super_secure_production_jwt_secret_here

# Frontend / Allowed CORS Origin
FRONTEND_URL=https://www.ekosmartdrive.in

# ============================================================================
# HostingRaja cPanel SMTP Configuration for Automatic OTP Emails & Invoices
# ============================================================================
# Outgoing Mail Server: server62.hostingraja.org
SMTP_HOST=server62.hostingraja.org

# Outgoing Port: 465 for SSL/TLS
SMTP_PORT=465
SMTP_SECURE=true

# Dedicated cPanel Email Account
SMTP_USER=support_otp_email@ekosmartdrivecomplain.in

# Password for the support_otp_email mailbox created in cPanel Email Accounts
SMTP_PASS=your_cpanel_mailbox_password_here

# Sender Display Name and Address
SMTP_FROM="Ekosmart Verification" <support_otp_email@ekosmartdrivecomplain.in>

# Set to true for production SSL validation; false only if using self-signed certs
SMTP_REJECT_UNAUTHORIZED=true
