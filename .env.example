# ==============================================================================
# EKOSMART PLATFORM - COMPLETE VERCEL ENVIRONMENT VARIABLES REFERENCE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API PROJECT (Root or backend/)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
# MongoDB Atlas Connection String (ensure IP Whitelist includes 0.0.0.0/0 on Atlas)
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/ekosmart?retryWrites=true&w=majority
# JWT Secret for authenticating Admin & Employee logins (32+ chars recommended)
JWT_SECRET=ekosmart_super_secure_production_jwt_secret_2026_ebs

# ------------------------------------------------------------------------------
# 2. CUSTOMER FRONTEND PROJECT (frontend/)
# ------------------------------------------------------------------------------
# Public API endpoint of your deployed backend
VITE_API_URL=https://your-backend-api.vercel.app/api/v1
VITE_API_HOST=https://your-backend-api.vercel.app

# ------------------------------------------------------------------------------
# 3. ADMIN PORTAL PROJECT (admin-portal/)
# ------------------------------------------------------------------------------
VITE_API_URL=https://your-backend-api.vercel.app/api/v1
VITE_API_HOST=https://your-backend-api.vercel.app
VITE_FRONTEND_URL=https://your-customer-frontend.vercel.app

# ------------------------------------------------------------------------------
# 4. EMPLOYEE / TECHNICIAN PORTAL PROJECT (employee-portal/)
# ------------------------------------------------------------------------------
VITE_API_URL=https://your-backend-api.vercel.app/api/v1
VITE_API_HOST=https://your-backend-api.vercel.app
