# ==============================================================================
# EKOSMART PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION REFERENCE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API SERVICE (backend/.env or cPanel Node.js App Environment)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# MongoDB Atlas or Remote Database Connection URI
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/ekosmart?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/ekosmart?retryWrites=true&w=majority

# Secret key for Admin, Employee & Customer JWT authentication (32+ chars)
JWT_SECRET=your_super_secure_production_jwt_secret_here

# Frontend / Allowed CORS Origins (comma-separated if multiple)
FRONTEND_URL=https://www.ekosmartdrive.in
CORS_ORIGIN=https://www.ekosmartdrive.in,https://ekosmartdrive.in,https://ekosmartdrivecomplain.in,https://www.ekosmartdrivecomplain.in

# Optional API Base URL Reference
API_BASE_URL=https://www.ekosmartdrive.in/api/v1

# HostingRaja cPanel SMTP Configuration for Automatic Secure OTP Emails & Invoices
SMTP_HOST=server62.hostingraja.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support_otp_email@ekosmartdrivecomplain.in
SMTP_PASS=your_cpanel_mailbox_password_here
SMTP_FROM="Ekosmart Verification" <support_otp_email@ekosmartdrivecomplain.in>
SMTP_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# 2. CUSTOMER FRONTEND PROJECT (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=https://www.ekosmartdrive.in/api/v1
VITE_API_HOST=https://www.ekosmartdrive.in
VITE_ADMIN_PORTAL_URL=https://www.ekosmartdrive.in/admin
VITE_EMPLOYEE_PORTAL_URL=https://www.ekosmartdrive.in/employee

# ------------------------------------------------------------------------------
# 3. ADMIN PORTAL PROJECT (admin-portal/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=https://www.ekosmartdrive.in/api/v1
VITE_API_HOST=https://www.ekosmartdrive.in
VITE_FRONTEND_URL=https://www.ekosmartdrive.in

# ------------------------------------------------------------------------------
# 4. EMPLOYEE / TECHNICIAN PORTAL PROJECT (employee-portal/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=https://www.ekosmartdrive.in/api/v1
VITE_API_HOST=https://www.ekosmartdrive.in
