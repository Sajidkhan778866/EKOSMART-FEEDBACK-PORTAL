{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["api/**/*", "backend/src/**/*", "backend/api/**/*"],
  "exclude": ["node_modules", "**/dist"]
}
